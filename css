/* ------------------------------
GENERAL STYLES
------------------------------ */

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
  }

html {
scroll-behavior: smooth;
}

body {
font-family: Arial, Helvetica, sans-serif;
background-color: #0f172a;
color: #e2e8f0;
line-height: 1.6;
}

/* ------------------------------
NAVIGATION
------------------------------ */

.navbar {
width: 100%;
padding: 20px 8%;
display: flex;
justify-content: space-between;
align-items: center;
background-color: #0f172a;
border-bottom: 1px solid #1e293b;
position: sticky;
top: 0;
z-index: 100;
}

.logo {
color: #38bdf8;
font-size: 24px;
letter-spacing: 1px;
}

.nav-links {
list-style: none;
display: flex;
gap: 30px;
}

.nav-links a {
color: #cbd5e1;
text-decoration: none;
font-size: 15px;
transition: color 0.3s ease;
}

.nav-links a:hover {
color: #38bdf8;
}

/* ------------------------------
HERO SECTION
------------------------------ */

.hero {
min-height: 85vh;
display: flex;
justify-content: center;
align-items: center;
text-align: center;
padding: 60px 20px;
background: linear-gradient(
135deg,
#0f172a,
#172554
);
}

.hero-content {
max-width: 750px;
}

.intro,
.section-label {
color: #38bdf8;
font-size: 14px;
font-weight: bold;
letter-spacing: 3px;
margin-bottom: 15px;
}

.hero h2 {
font-size: 64px;
margin-bottom: 20px;
color: #f8fafc;
}

.hero p:not(.intro) {
max-width: 600px;
margin: 0 auto 30px;
color: #94a3b8;
font-size: 18px;
}

/* ------------------------------
BUTTONS
------------------------------ */

.button {
display: inline-block;
padding: 12px 24px;
background-color: #38bdf8;
color: #0f172a;
text-decoration: none;
font-weight: bold;
border-radius: 6px;
transition: all 0.3s ease;
}

.button:hover {
background-color: #7dd3fc;
transform: translateY(-3px);
}

/* ------------------------------
GENERAL SECTIONS
------------------------------ */

.section {
padding: 100px 8%;
}

.section h2 {
font-size: 40px;
color: #f8fafc;
margin-bottom: 20px;
}

.section-description {
color: #94a3b8;
max-width: 650px;
margin-bottom: 45px;
}

/* ------------------------------
ABOUT SECTION
------------------------------ */

.about {
display: flex;
justify-content: space-between;
align-items: center;
gap: 60px;
background-color: #111827;
}

.about-text {
max-width: 650px;
}

.about-text p:not(.section-label) {
color: #94a3b8;
margin-bottom: 20px;
}

.about-card {
min-width: 280px;
padding: 40px;
text-align: center;
background-color: #1e293b;
border: 1px solid #334155;
border-radius: 12px;
box-shadow: 0 10px 30px rgba(0, 0, 0, 0.25);
}

.profile-icon {
width: 110px;
height: 110px;
margin: 0 auto 20px;
display: flex;
justify-content: center;
align-items: center;
border-radius: 50%;
background-color: #38bdf8;
color: #0f172a;
font-size: 30px;
font-weight: bold;
}

.about-card h3 {
color: #f8fafc;
margin-bottom: 5px;
}

.about-card p {
color: #94a3b8;
}

/* ------------------------------
PROJECTS
------------------------------ */

.projects {
background-color: #0f172a;
}

.project-container {
display: flex;
gap: 25px;
flex-wrap: wrap;
}

.project-card {
flex: 1;
min-width: 250px;
padding: 30px;
background-color: #1e293b;
border: 1px solid #334155;
border-radius: 10px;
transition: transform 0.3s ease, border-color 0.3s ease;
}

.project-card:hover {
transform: translateY(-8px);
border-color: #38bdf8;
}

.project-number {
color: #38bdf8;
font-size: 14px;
font-weight: bold;
margin-bottom: 15px;
}

.project-card h3 {
color: #f8fafc;
font-size: 24px;
margin-bottom: 15px;
}

.project-card p {
color: #94a3b8;
margin-bottom: 25px;
}

.project-link {
color: #38bdf8;
text-decoration: none;
font-weight: bold;
}

.project-link:hover {
text-decoration: underline;
}

/* ------------------------------
CONTACT
------------------------------ */

.contact {
text-align: center;
background-color: #111827;
}

.contact-content {
max-width: 600px;
margin: 0 auto;
}

.contact-content p:not(.section-label) {
color: #94a3b8;
margin-bottom: 30px;
}

/* ------------------------------
FOOTER
------------------------------ */

footer {
padding: 25px;
text-align: center;
background-color: #020617;
color: #64748b;
font-size: 14px;
}

/* ------------------------------
RESPONSIVE DESIGN
------------------------------ */

@media (max-width: 768px) {

.navbar {
flex-direction: column;
gap: 15px;
}

.nav-links {
gap: 15px;
}

.hero h2 {
font-size: 45px;
}

.section {
padding: 70px 6%;
}

.about {
flex-direction: column;
text-align: center;
}

.about-card {
width: 100%;
}

.project-container {
flex-direction: column;
}

.project-card {
width: 100%;
}
}
